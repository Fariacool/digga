# Local development; docker-compose.yml sets ENVIRONMENT=production.
ENVIRONMENT="development"

# Public origin of this instance, read at container runtime.
SITE_URL="http://localhost:3000"

# Optional: leave empty to keep public access.
API_KEY=""

GOOGLE_SERVICE_KEY_B64=""
BIGQUERY_DATASET=""
BIGQUERY_LOCATION="EU"

# Optional runtime analytics configuration. Leave empty to disable analytics.
NEXT_PUBLIC_ANALYTICS_SCRIPT=""
NEXT_PUBLIC_ANALYTICS_ID=""
# Optional domain filter; leave empty to omit filtering.
NEXT_PUBLIC_ANALYTICS_DOMAINS=""

ALLOWED_BOTS=''

SUBFINDER_BIN=""
SUBFINDER_MAX_CONCURRENT="3"
SUBFINDER_ALL_SOURCES="false"

# Optional runtime Turnstile configuration; set both values to enable it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

INDEXNOW_KEY=""

# Docker Compose deployment
IMAGE_NAME="ghcr.io/fariacool/digga:latest"
HOST_BIND_ADDRESS="0.0.0.0"
HOST_PORT="3000"
TZ="UTC"
RESTART_POLICY="unless-stopped"
LOG_MAX_SIZE="10m"
LOG_MAX_FILE="3"
